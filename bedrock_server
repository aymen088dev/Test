#!/bin/sh
# ---------------------------------------------------------------------------
# bedrock_server  ==  wrapper Endstone
#
# Pterodactyl ne lance que "./bedrock_server". Ce fichier remplace le binaire
# vanilla : il installe Python 3 au besoin, installe Endstone, puis le lance.
#
# Installation :
#   1. Arrete le serveur.
#   2. Renomme le vrai binaire  bedrock_server  ->  bedrock_server.orig
#   3. Depose CE fichier sous le nom  bedrock_server
#   4. chmod +x bedrock_server   (via SFTP, le gestionnaire web ne gere pas le +x)
#   5. Demarre. Plugins : place tes .whl dans ./plugins/
# ---------------------------------------------------------------------------

cd "$(dirname "$0")" || exit 1

echo "[endstone] Verification de Python 3..."

# --- 1) Python 3 present ? sinon on l'installe ---------------------------
if ! command -v python3 >/dev/null 2>&1; then
    echo "[endstone] python3 absent : demande d'installation..."
    if command -v apt-get >/dev/null 2>&1; then
        apt-get update -y && apt-get install -y python3 python3-pip python3-venv
    elif command -v apk >/dev/null 2>&1; then
        apk add --no-cache python3 py3-pip
    elif command -v dnf >/dev/null 2>&1; then
        dnf install -y python3 python3-pip
    else
        echo "[endstone] ERREUR : aucun gestionnaire de paquets (apt/apk/dnf)." >&2
        echo "[endstone] Impossible d'installer python3 depuis ce conteneur." >&2
        exit 1
    fi
fi

if ! command -v python3 >/dev/null 2>&1; then
    echo "[endstone] ERREUR : python3 toujours introuvable apres installation." >&2
    exit 1
fi

PYVER="$(python3 -c 'import sys; print("%d.%d" % sys.version_info[:2])' 2>/dev/null)"
echo "[endstone] Python $PYVER detecte."

# --- 2) Environnement endstone isole et persistant -----------------------
VENV=".endstone-venv"
if [ ! -x "$VENV/bin/python" ]; then
    echo "[endstone] Creation de l'environnement virtuel..."
    if ! python3 -m venv "$VENV"; then
        # venv absent : on installe python3-venv puis on reessaie
        if command -v apt-get >/dev/null 2>&1; then
            apt-get install -y python3-venv
        fi
        python3 -m venv "$VENV" || { echo "[endstone] ERREUR : venv impossible." >&2; exit 1; }
    fi
fi

# --- 3) Installation / mise a jour d'Endstone ----------------------------
if [ -n "$ENDSTONE_VERSION" ]; then
    PKG="endstone==$ENDSTONE_VERSION"
else
    PKG="endstone"
fi
echo "[endstone] Installation de $PKG..."
"$VENV/bin/python" -m pip install -q -U pip
"$VENV/bin/python" -m pip install -q -U --no-warn-script-location "$PKG"

# --- 4) Lancement --------------------------------------------------------
mkdir -p plugins
echo "[endstone] Demarrage du serveur Endstone..."
exec "$VENV/bin/python" -m endstone -s . -y
