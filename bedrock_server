#!/bin/sh
# ---------------------------------------------------------------------------
# bedrock_server  ==  wrapper qui lance le dossier "serveur/"
#
# Pterodactyl ne lance que la commande fixe "./bedrock_server". Ce fichier
# remplace le binaire vanilla et execute l'installeur Endstone situe dans
# le dossier serveur : ./serveur/start.sh
#
# Installation sur le serveur :
#   1. Arrete le serveur.
#   2. Renomme le vrai binaire  bedrock_server  ->  bedrock_server.orig
#   3. Copie CE fichier + le dossier  serveur/  a la racine du serveur.
#   4. chmod +x bedrock_server   (via SFTP, le gestionnaire web ne gere pas le +x)
#   5. Demarre. Plugins Endstone : dossier  plugins/  a la racine.
# ---------------------------------------------------------------------------

cd "$(dirname "$0")" || exit 1

if [ ! -f "./serveur/start.sh" ]; then
    echo "[endstone] ERREUR : ./serveur/start.sh introuvable." >&2
    echo "[endstone] Copie le dossier 'serveur/' a cote de ce fichier." >&2
    exit 1
fi

echo "[endstone] Delegation a ./serveur/start.sh"
exec sh ./serveur/start.sh "$@"
